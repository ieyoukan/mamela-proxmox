{
  "schema": "mamela-catalog/v1",
  "api": "proxmox",
  "entries": [
    {
      "method": "GET",
      "path": "/access/permissions",
      "effect": "read",
      "query": [
        "path",
        "userid"
      ]
    },
    {
      "method": "GET",
      "path": "/cluster/resources",
      "effect": "read",
      "query": [
        "type"
      ]
    },
    {
      "method": "GET",
      "path": "/cluster/status",
      "effect": "read"
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/lxc/{vmid}/config",
      "effect": "read"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu",
      "effect": "create",
      "form": [
        "agent",
        "boot",
        "cores",
        "description",
        "ide2",
        "memory",
        "name",
        "net0",
        "onboot",
        "ostype",
        "pool",
        "scsi0",
        "scsihw",
        "serial0",
        "vga",
        "vmid"
      ],
      "measures": [
        {
          "param": "cores",
          "name": "cpu",
          "format": "count"
        },
        {
          "param": "memory",
          "name": "memoryMiB",
          "format": "count"
        },
        {
          "param": "scsi0",
          "name": "diskGiB",
          "format": "drive"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{template}/clone",
      "effect": "create",
      "form": [
        "description",
        "full",
        "name",
        "newid",
        "pool"
      ],
      "values": {
        "full": [
          "0"
        ]
      },
      "bind": [
        "newid"
      ]
    },
    {
      "method": "DELETE",
      "path": "/nodes/{node}/qemu/{vmid}",
      "effect": "lose-data",
      "query": [
        "destroy-unreferenced-disks"
      ]
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/qemu/{vmid}/config",
      "effect": "read"
    },
    {
      "method": "PUT",
      "path": "/nodes/{node}/qemu/{vmid}/config",
      "effect": "change",
      "form": [
        "cores",
        "description",
        "digest",
        "ide2",
        "memory",
        "tags"
      ],
      "precondition": "digest",
      "measures": [
        {
          "param": "cores",
          "name": "cpu",
          "format": "count"
        },
        {
          "param": "memory",
          "name": "memoryMiB",
          "format": "count"
        }
      ]
    },
    {
      "method": "PUT",
      "path": "/nodes/{node}/qemu/{vmid}/resize",
      "effect": "change",
      "form": [
        "digest",
        "disk",
        "size"
      ],
      "precondition": "digest",
      "measures": [
        {
          "param": "size",
          "name": "diskGiB",
          "format": "size"
        }
      ]
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/qemu/{vmid}/status/current",
      "effect": "read"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{vmid}/status/reboot",
      "effect": "restart"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{vmid}/status/reset",
      "effect": "restart"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{vmid}/status/shutdown",
      "effect": "restart"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{vmid}/status/start",
      "effect": "restart"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{vmid}/status/stop",
      "effect": "restart"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/qemu/{vmid}/template",
      "effect": "change"
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/status",
      "effect": "read"
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/storage",
      "effect": "read",
      "query": [
        "content"
      ]
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/storage/{storage}/content",
      "effect": "read",
      "query": [
        "content"
      ]
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/storage/{storage}/status",
      "effect": "read"
    },
    {
      "method": "POST",
      "path": "/nodes/{node}/storage/{storage}/upload",
      "effect": "create",
      "form": [
        "checksum",
        "checksum-algorithm",
        "content"
      ],
      "file": "filename"
    },
    {
      "method": "GET",
      "path": "/nodes/{node}/tasks/{upid}/status",
      "effect": "read"
    }
  ]
}
