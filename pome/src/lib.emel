## Proxmox: virtual machines on Proxmox VE that Mamela's agent (mamelet) runs on, made by the
## proxmox provider (github.com/ieyoukan/mamela-proxmox). The provider runs isolated and reaches
## Proxmox only through Mamela, which holds the token, checks every request and makes the files a
## VM is created from: the pinned cloud image and the VM's mamelet seed.
##
## A VM is a node: declare packages, services and k3s on `Proxmox.node(vm)` with
## `Mamela.package_on` and the other `*_on` functions.

import Mamela
import Mamela.{Network, Dhcp, Static}
import Dynamic.{Dynamic, Text, Items}
import Dynamic.Number

## The provider, as its manifest names it.
pub const PROVIDER = "proxmox"

## The resource kind.
pub const KIND = "ProxmoxVM"

## Where VMs go on the cluster: the Proxmox node, the pool the token may change, the storages for
## disks and for images and seeds, the bridge, the tag Mamela puts on them, and the VMIDs it may
## use. In a lab, these are the site's.
pub type Site(
  node: String,
  pool: String,
  disk_storage: String,
  image_storage: String,
  bridge: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
)

## A VM: `memory_mib` in MiB, `disk_gib` in GiB, `image` one of the provider's pinned images
## ("ubuntu-24.04"), and how it gets its address.
pub type Vm(name: String, cpu: Int, memory_mib: Int, disk_gib: Int, image: String, network: Network)

fn int(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}

fn network_json(n: Network) -> Dynamic {
  n match {
    Dhcp -> Dynamic.object([("mode", Text("dhcp"))])
    Static(address: address, gateway: gateway, dns: dns) -> {
      Dynamic.object(
        [
          ("mode", Text("static")),
          ("address", Text(address)),
          ("gateway", Text(gateway)),
          ("dns", Items(dns.map(Text))),
        ],
      )
    }
  }
}

## Declares the VM on the site.
pub fn vm(graph: Mamela.Graph, site: Site, vm: Vm) -> Mamela.Graph {
  spec = [
    ("node", Text(site.node)),
    ("pool", Text(site.pool)),
    ("diskStorage", Text(site.disk_storage)),
    ("imageStorage", Text(site.image_storage)),
    ("bridge", Text(site.bridge)),
    ("tag", Text(site.tag)),
    ("vmidMin", int(site.vmid_min)),
    ("vmidMax", int(site.vmid_max)),
    ("cpu", int(vm.cpu)),
    ("memoryMiB", int(vm.memory_mib)),
    ("diskGiB", int(vm.disk_gib)),
    ("image", Text(vm.image)),
    ("network", network_json(vm.network)),
  ]
  Mamela.provided(graph, PROVIDER, KIND, vm.name, spec)
}

## The VM as a node, for packages, services and k3s on it.
pub fn node(vm: Vm) -> Mamela.Node {
  Mamela.Node(name: vm.name)
}
