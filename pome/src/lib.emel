## Proxmox: virtual machines on Proxmox VE that Mamela's agent (mamelet) runs on, made by the
## proxmox provider (github.com/ieyoukan/mamela-proxmox). The provider runs isolated and reaches
## Proxmox only through Mamela, which holds the token, checks every request and makes the files a
## VM is created from: the pinned cloud image and the VM's mamelet seed.
##
## A VM is a node: declare packages and services on `Proxmox.node(vm)` with `Mamela.package` and
## `Mamela.service`, and k3s with the K3s Pome.
##
## A VM is a linked clone of a template of its image: `Proxmox.vm` declares the template too (the
## same way for every VM of the image on the node, which Mamela takes as one resource). Mamela makes
## the template once, from the pinned image, and each VM from it in seconds; the template is deleted
## only by the explicit `delete-template`, once no VM is cloned from it.
##
## The typed declarations of every kind, generated from the provider's manifest, are in
## `Proxmox.Kinds` (src/kinds.emel): `mamela import terraform` writes the VMs it imports with them.

import Mamela
import Mamela.{Network, Ref}
import Dynamic.{Dynamic, Text}
import Dynamic.Number

## The provider, as its manifest names it.
pub const PROVIDER = "proxmox"

## The resource kinds.
pub const KIND = "ProxmoxVM"
pub const TEMPLATE_KIND = "ProxmoxTemplate"

## Where VMs go on the cluster: the Proxmox node, the pool the token may change, the storages for
## disks and for images and seeds, the bridge, the tag Mamela puts on them, and the VMIDs it may
## use. In a lab, these are the site's.
pub type Site(
  node: String,
  pool: String,
  disk_storage: String,
  image_storage: String,
  bridge: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
)

## A VM: `memory_mib` in MiB, `disk_gib` in GiB, `image` one of the provider's pinned images
## ("ubuntu-24.04"), and how it gets its address.
pub type Vm(name: String, cpu: Int, memory_mib: Int, disk_gib: Int, image: String, network: Network)

fn int(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}

fn site_spec(site: Site) -> List[(String, Dynamic)] {
  [
    ("node", Text(site.node)),
    ("pool", Text(site.pool)),
    ("diskStorage", Text(site.disk_storage)),
    ("imageStorage", Text(site.image_storage)),
    ("bridge", Text(site.bridge)),
    ("tag", Text(site.tag)),
    ("vmidMin", int(site.vmid_min)),
    ("vmidMax", int(site.vmid_max)),
  ]
}

## The name of the template of an image on the site's node ("ubuntu-24.04-pve1").
pub fn template_name(site: Site, image: String) -> String {
  "#{image}-#{site.node}"
}

## Declares the VM on the site, and the template of its image it is cloned from. Mamela starts it
## once it is made, and again whenever it finds it stopped.
pub fn vm(graph: Mamela.Graph, site: Site, vm: Vm) -> Mamela.Graph {
  declare(graph, site, vm, [])
}

## Declares the VM like `vm`, kept stopped: Mamela makes it without starting it, and shuts it down
## (asks its guest to power off) when it finds it running.
pub fn vm_stopped(graph: Mamela.Graph, site: Site, vm: Vm) -> Mamela.Graph {
  declare(graph, site, vm, [("stopped", Dynamic.Bool(True))])
}

fn declare(
  graph: Mamela.Graph,
  site: Site,
  vm: Vm,
  extra: List[(String, Dynamic)],
) -> Mamela.Graph {
  template = template_name(site, vm.image)
  with_template = Mamela.provided(
    graph,
    PROVIDER,
    TEMPLATE_KIND,
    template,
    List.append(site_spec(site), [("image", Text(vm.image))]),
  )
  spec = [
    ("node", Text(site.node)),
    ("pool", Text(site.pool)),
    ("diskStorage", Text(site.disk_storage)),
    ("imageStorage", Text(site.image_storage)),
    ("bridge", Text(site.bridge)),
    ("tag", Text(site.tag)),
    ("vmidMin", int(site.vmid_min)),
    ("vmidMax", int(site.vmid_max)),
    ("cpu", int(vm.cpu)),
    ("memoryMiB", int(vm.memory_mib)),
    ("diskGiB", int(vm.disk_gib)),
    ("image", Text(vm.image)),
    ("network", Mamela.network_spec(vm.network)),
    ("template", Text(template)),
  ]
  Mamela.provided_after(
    with_template,
    PROVIDER,
    KIND,
    vm.name,
    List.append(spec, extra),
    [Ref(kind: TEMPLATE_KIND, name: template)],
  )
}

## The VM as a node, for packages, services and k3s on it.
pub fn node(vm: Vm) -> Mamela.Node {
  Mamela.Node(name: vm.name)
}
