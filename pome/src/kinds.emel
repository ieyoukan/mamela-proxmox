## Proxmox.Kinds: the resources of the Mamela provider "proxmox", version 0.2.0.
##
## Code generated by `mamela provider pome` from the provider's manifest; DO NOT EDIT.
## Importing this Pome is how a declaration uses the provider: the functions here declare its
## resources, and the Pome holds the provider's program (mamela-provider.toml), which Mamela runs
## isolated. A field that refers to another resource takes its value, so that the reference names
## something declared; Mamela plans a resource once those it refers to exist.

import Mamela
import Mamela.{Ref}
import Dynamic.{Dynamic, Text, Items}
import Dynamic.Number

## The provider, as its manifest names it.
pub const PROVIDER = "proxmox"

## A virtual machine on Proxmox VE that Mamela's agent (mamelet) runs on: a linked clone of the template of its image
## (template), or made from its image directly. Declare packages and services on it as a node.
##
## `node`: the Proxmox VE node
## `pool`: the pool Mamela's token may change
## `disk_storage`: the storage of its disk
## `image_storage`: the storage of the images and seeds it is made from
## `bridge`: the bridge of its network
## `tag`: the tag Mamela puts on its VMs
## `vmid_min`: the first VMID Mamela may use
## `vmid_max`: the last VMID Mamela may use
## `cpu`: vCPUs (cores of one socket)
## `memory_mi_b`: memory in MiB
## `disk_gi_b`: the disk (scsi0) in GiB
## `image`: the pinned image it is made from (ubuntu-24.04); none for a VM imported to adopt (optional)
## `network`: how it gets its address (given once, when it is created)
## `template`: the template it is a linked clone of (optional)
## `stopped`: keep it stopped (a running one is shut down) (optional)
pub type ProxmoxVm(
  name: String,
  node: String,
  pool: String,
  disk_storage: String,
  image_storage: String,
  bridge: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
  cpu: Int,
  memory_mi_b: Int,
  disk_gi_b: Int,
  image: Option[String],
  network: Network,
  template: Option[ProxmoxTemplate],
  stopped: Option[Bool],
)

## Declares the ProxmoxVM: Mamela makes it so, through the provider.
pub fn proxmox_vm(graph: Mamela.Graph, r: ProxmoxVm) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("node", Text(r.node))],
      [("pool", Text(r.pool))],
      [("diskStorage", Text(r.disk_storage))],
      [("imageStorage", Text(r.image_storage))],
      [("bridge", Text(r.bridge))],
      [("tag", Text(r.tag))],
      [("vmidMin", integer(r.vmid_min))],
      [("vmidMax", integer(r.vmid_max))],
      [("cpu", integer(r.cpu))],
      [("memoryMiB", integer(r.memory_mi_b))],
      [("diskGiB", integer(r.disk_gi_b))],
      r.image match {
        Some(v) -> [("image", Text(v))]
        None    -> []
      },
      [("network", network_spec(r.network))],
      r.template match {
        Some(v) -> [("template", Text(v.name))]
        None    -> []
      },
      r.stopped match {
        Some(v) -> [("stopped", Dynamic.Bool(v))]
        None    -> []
      },
    ],
  )
  after = List.flatten(
    [
      r.template match {
        Some(v) -> [proxmox_template_ref(v)]
        None    -> []
      },
    ],
  )
  Mamela.provided_after(graph, PROVIDER, "ProxmoxVM", r.name, spec, after)
}

## A reference to the ProxmoxVM, for what needs it first.
pub fn proxmox_vm_ref(r: ProxmoxVm) -> Ref {
  Ref(kind: "ProxmoxVM", name: r.name)
}

## The ProxmoxVM as a node: what mamelet runs on, to declare packages and services on.
pub fn proxmox_vm_node(r: ProxmoxVm) -> Mamela.Node {
  Mamela.Node(name: r.name)
}

## The template of an image on a node, made once from the pinned image: the VMs of the image are linked clones of it.
## Proxmox.vm declares it with each VM; it is deleted only by the explicit delete-template, once no VM is cloned from it.
##
## `node`: the Proxmox VE node
## `pool`: the pool Mamela's token may change
## `disk_storage`: the storage of its disk
## `image_storage`: the storage of the image it is made from
## `bridge`: the bridge of its network
## `tag`: the tag Mamela puts on its VMs
## `vmid_min`: the first VMID Mamela may use
## `vmid_max`: the last VMID Mamela may use (templates take theirs from the top)
## `image`: the pinned image (ubuntu-24.04)
pub type ProxmoxTemplate(
  name: String,
  node: String,
  pool: String,
  disk_storage: String,
  image_storage: String,
  bridge: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
  image: String,
)

## Declares the ProxmoxTemplate: Mamela makes it so, through the provider.
pub fn proxmox_template(graph: Mamela.Graph, r: ProxmoxTemplate) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("node", Text(r.node))],
      [("pool", Text(r.pool))],
      [("diskStorage", Text(r.disk_storage))],
      [("imageStorage", Text(r.image_storage))],
      [("bridge", Text(r.bridge))],
      [("tag", Text(r.tag))],
      [("vmidMin", integer(r.vmid_min))],
      [("vmidMax", integer(r.vmid_max))],
      [("image", Text(r.image))],
    ],
  )
  Mamela.provided(graph, PROVIDER, "ProxmoxTemplate", r.name, spec)
}

## A reference to the ProxmoxTemplate, for what needs it first.
pub fn proxmox_template_ref(r: ProxmoxTemplate) -> Ref {
  Ref(kind: "ProxmoxTemplate", name: r.name)
}

## A Network, part of a spec.
##
## `address`: (optional)
## `gateway`: (optional)
## `dns`: (optional)
pub type Network(mode: String, address: Option[String], gateway: Option[String], dns: List[String])

fn network_spec(o: Network) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("mode", Text(o.mode))],
        o.address match {
          Some(v) -> [("address", Text(v))]
          None    -> []
        },
        o.gateway match {
          Some(v) -> [("gateway", Text(v))]
          None    -> []
        },
        if List.is_empty(o.dns) { [] } else { [("dns", Items(o.dns.map(|x| Text(x))))] },
      ],
    ),
  )
}

fn integer(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}
