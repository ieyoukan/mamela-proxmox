import Mamela
import Mamela.{Ref}
import Dynamic.{Dynamic, Text, Items}
import Dynamic.Number

## The provider, as its manifest names it.
pub const PROVIDER = "proxmox"

## A virtual machine on Proxmox VE that Mamela's agent (mamelet) runs on: a linked clone of the template of its image
## (template), or made from its image directly. Declare packages and services on it as a node.
##
## `node`: the Proxmox VE node
## `pool`: the pool Mamela's token may change
## `disk_storage`: the storage of its disk
## `image_storage`: the storage of the images and seeds it is made from
## `bridge`: the bridge of its network
## `tag`: the tag Mamela puts on its VMs
## `vmid_min`: the first VMID Mamela may use
## `vmid_max`: the last VMID Mamela may use
## `cpu`: vCPUs (cores of one socket)
## `memory_mi_b`: memory in MiB
## `disk_gi_b`: the disk (scsi0) in GiB
## `image`: the pinned image it is made from (ubuntu-24.04); none for a VM imported to adopt (optional)
## `network`: how it gets its address (given once, when it is created)
## `template`: the template it is a linked clone of (optional)
## `stopped`: keep it stopped (a running one is shut down) (optional)
pub type ProxmoxVm(
  name: String,
  node: String,
  pool: String,
  disk_storage: String,
  image_storage: String,
  bridge: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
  cpu: Int,
  memory_mi_b: Int,
  disk_gi_b: Int,
  image: Option[String],
  network: Network,
  template: Option[ProxmoxTemplate],
  stopped: Option[Bool],
)

## Declares the ProxmoxVM: Mamela makes it so, through the provider.
pub fn proxmox_vm(graph: Mamela.Graph, r: ProxmoxVm) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("node", Text(r.node))],
      [("pool", Text(r.pool))],
      [("diskStorage", Text(r.disk_storage))],
      [("imageStorage", Text(r.image_storage))],
      [("bridge", Text(r.bridge))],
      [("tag", Text(r.tag))],
      [("vmidMin", integer(r.vmid_min))],
      [("vmidMax", integer(r.vmid_max))],
      [("cpu", integer(r.cpu))],
      [("memoryMiB", integer(r.memory_mi_b))],
      [("diskGiB", integer(r.disk_gi_b))],
      r.image match {
        Some(v) -> [("image", Text(v))]
        None    -> []
      },
      [("network", network_spec(r.network))],
      r.template match {
        Some(v) -> [("template", Text(v.name))]
        None    -> []
      },
      r.stopped match {
        Some(v) -> [("stopped", Dynamic.Bool(v))]
        None    -> []
      },
    ],
  )
  after = List.flatten(
    [
      r.template match {
        Some(v) -> [proxmox_template_ref(v)]
        None    -> []
      },
    ],
  )
  Mamela.provided_after(graph, PROVIDER, "ProxmoxVM", r.name, spec, after)
}

## A reference to the ProxmoxVM, for what needs it first.
pub fn proxmox_vm_ref(r: ProxmoxVm) -> Ref {
  Ref(kind: "ProxmoxVM", name: r.name)
}

## The ProxmoxVM as a node: what mamelet runs on, to declare packages and services on.
pub fn proxmox_vm_node(r: ProxmoxVm) -> Mamela.Node {
  Mamela.Node(name: r.name)
}

## The template of an image on a node, made once from the pinned image: the VMs of the image are linked clones of it.
## Proxmox.vm declares it with each VM; it is deleted only by the explicit delete-template, once no VM is cloned from it.
##
## `node`: the Proxmox VE node
## `pool`: the pool Mamela's token may change
## `disk_storage`: the storage of its disk
## `image_storage`: the storage of the image it is made from
## `bridge`: the bridge of its network
## `tag`: the tag Mamela puts on its VMs
## `vmid_min`: the first VMID Mamela may use
## `vmid_max`: the last VMID Mamela may use (templates take theirs from the top)
## `image`: the pinned image (ubuntu-24.04)
pub type ProxmoxTemplate(
  name: String,
  node: String,
  pool: String,
  disk_storage: String,
  image_storage: String,
  bridge: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
  image: String,
)

## Declares the ProxmoxTemplate: Mamela makes it so, through the provider.
pub fn proxmox_template(graph: Mamela.Graph, r: ProxmoxTemplate) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("node", Text(r.node))],
      [("pool", Text(r.pool))],
      [("diskStorage", Text(r.disk_storage))],
      [("imageStorage", Text(r.image_storage))],
      [("bridge", Text(r.bridge))],
      [("tag", Text(r.tag))],
      [("vmidMin", integer(r.vmid_min))],
      [("vmidMax", integer(r.vmid_max))],
      [("image", Text(r.image))],
    ],
  )
  Mamela.provided(graph, PROVIDER, "ProxmoxTemplate", r.name, spec)
}

## A reference to the ProxmoxTemplate, for what needs it first.
pub fn proxmox_template_ref(r: ProxmoxTemplate) -> Ref {
  Ref(kind: "ProxmoxTemplate", name: r.name)
}

## A container (LXC) on Proxmox VE that a person made, which Mamela manages once adopted (adopt-lxc): only the values
## declared; an omitted value is never changed. Mamela never creates, moves or deletes a container, and never shrinks its disk.
## One outside the pool and the VMIDs is declared named, on its node, and named in the guard's settings too.
##
## `node`: the Proxmox VE node the container is on
## `pool`: the pool Mamela's token may change (the container is in it, unless named)
## `tag`: the tag Mamela adds to the container's tags
## `vmid_min`: the first VMID Mamela may use
## `vmid_max`: the last VMID Mamela may use
## `vmid`: the VMID of the existing container to adopt (made by hand; Mamela creates none)
## `named`: outside the pool and the VMIDs: a container the guard's settings name ([[provider.proxmox.guard.named]]), adopted where it is (optional)
## `cores`: its cores (not managed when omitted) (optional)
## `memory_mib`: its memory in MiB (not managed when omitted) (optional)
## `swap_mib`: its swap in MiB (not managed when omitted) (optional)
## `rootfs_gib`: its root filesystem in GiB, only ever grown (not managed when omitted) (optional)
## `onboot`: start it when the node boots (not managed when omitted) (optional)
## `power`: keep it running or stopped (not managed when omitted) (running, stopped) (optional)
pub type ProxmoxLxc(
  name: String,
  node: String,
  pool: String,
  tag: String,
  vmid_min: Int,
  vmid_max: Int,
  vmid: Int,
  named: Option[Bool],
  cores: Option[Int],
  memory_mib: Option[Int],
  swap_mib: Option[Int],
  rootfs_gib: Option[Int],
  onboot: Option[Bool],
  power: Option[ProxmoxLxcPower],
)

## Declares the ProxmoxLXC: Mamela makes it so, through the provider.
pub fn proxmox_lxc(graph: Mamela.Graph, r: ProxmoxLxc) -> Mamela.Graph {
  spec = List.flatten(
    [
      [("node", Text(r.node))],
      [("pool", Text(r.pool))],
      [("tag", Text(r.tag))],
      [("vmidMin", integer(r.vmid_min))],
      [("vmidMax", integer(r.vmid_max))],
      [("vmid", integer(r.vmid))],
      r.named match {
        Some(v) -> [("named", Dynamic.Bool(v))]
        None    -> []
      },
      r.cores match {
        Some(v) -> [("cores", integer(v))]
        None    -> []
      },
      r.memory_mib match {
        Some(v) -> [("memoryMib", integer(v))]
        None    -> []
      },
      r.swap_mib match {
        Some(v) -> [("swapMib", integer(v))]
        None    -> []
      },
      r.rootfs_gib match {
        Some(v) -> [("rootfsGib", integer(v))]
        None    -> []
      },
      r.onboot match {
        Some(v) -> [("onboot", Dynamic.Bool(v))]
        None    -> []
      },
      r.power match {
        Some(v) -> [("power", proxmox_lxc_power_text(v))]
        None    -> []
      },
    ],
  )
  Mamela.provided(graph, PROVIDER, "ProxmoxLXC", r.name, spec)
}

## A reference to the ProxmoxLXC, for what needs it first.
pub fn proxmox_lxc_ref(r: ProxmoxLxc) -> Ref {
  Ref(kind: "ProxmoxLXC", name: r.name)
}

## The ProxmoxLXC as a node: what mamelet runs on, to declare packages and services on.
pub fn proxmox_lxc_node(r: ProxmoxLxc) -> Mamela.Node {
  Mamela.Node(name: r.name)
}

## The values of ProxmoxLxcPower.
pub enum ProxmoxLxcPower {
  Running
  Stopped
}

fn proxmox_lxc_power_text(v: ProxmoxLxcPower) -> Dynamic {
  v match {
    Running -> Text("running")
    Stopped -> Text("stopped")
  }
}

## A Network, part of a spec.
##
## `address`: (optional)
## `gateway`: (optional)
## `dns`: (optional)
pub type Network(mode: String, address: Option[String], gateway: Option[String], dns: List[String])

fn network_spec(o: Network) -> Dynamic {
  Dynamic.object(
    List.flatten(
      [
        [("mode", Text(o.mode))],
        o.address match {
          Some(v) -> [("address", Text(v))]
          None    -> []
        },
        o.gateway match {
          Some(v) -> [("gateway", Text(v))]
          None    -> []
        },
        if List.is_empty(o.dns) { [] } else { [("dns", Items(o.dns.map(|x| Text(x))))] },
      ],
    ),
  )
}

fn integer(n: Int) -> Dynamic {
  Dynamic.Number(Number.from_int(n))
}
